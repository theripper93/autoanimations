<div class="aa-menu-manager-body">
  <div class="form-group">
    <label>{{localize "autoanimations.settings.restoreHint"}}</label>
    <div class="form-fields"><button type="button" data-action="restore"><i class="fa-solid fa-rotate-left"></i> {{localize "autoanimations.settings.restoreDefault"}}</button></div>
  </div>
  <div class="form-group">
    <label>{{localize "autoanimations.settings.mergeHint"}}</label>
    <div class="form-fields"><button type="button" data-action="merge"><i class="fa-solid fa-code-merge"></i> {{localize "autoanimations.menus.merge"}} {{localize "autoanimations.menus.menu"}}</button></div>
  </div>
  <div class="form-group">
    <label>{{localize "autoanimations.settings.overwriteHint"}}</label>
    <div class="form-fields"><button type="button" data-action="overwrite"><i class="fa-solid fa-file-import"></i> {{localize "autoanimations.menus.overwrite"}} {{localize "autoanimations.menus.menu"}}</button></div>
  </div>
  <div class="form-group">
    <label>{{localize "autoanimations.settings.exportHint"}}</label>
    <div class="form-fields"><button type="button" data-action="export"><i class="fa-solid fa-file-export"></i> {{localize "autoanimations.menus.export"}} {{localize "autoanimations.menus.menu"}}</button></div>
  </div>
  <div class="form-group">
    <label>{{localize "autoanimations.settings.deleteHint"}}</label>
    <div class="form-fields"><button type="button" data-action="deleteMenus"><i class="fa-solid fa-trash"></i> {{localize "autoanimations.menus.delete"}} {{localize "autoanimations.menus.menu"}}</button></div>
  </div>
</div>
